{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run as root",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/yaxelb",
            "args": [
                "-config-file", "${workspaceFolder}/examples/config.yaml",
                "-interface", "dummy0",
            ],
            "asRoot": true
        },
        {
            "name": "Yaxelb IPv6",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/yaxelb",
            "args": [
                "-interface", "dummyV6",
                "-config-file", "${workspaceFolder}/examples/config-v6.yaml",
                "-enable-healthcheck", "true",
            ],
            "asRoot": true
        },
        {
            "name": "Debug CLI",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/yaxelb-dbg",
            "args": ["maps"],
            "asRoot": true
        }
    ]
}
